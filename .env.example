# Copier vers .env (non versionné). Choisir un port libre sur le VPS.
COMPOSE_PROJECT_NAME=loup-garou-api
NODE_ENV=production
API_HOST_PORT=3009
APP_ORIGIN=https://loup-garou.bouchard-mehdi.fr
LOG_LEVEL=info
# Obligatoire : générer un secret de session d'au moins 32 caractères.
SESSION_SECRET=
# Expiration absolue, non prolongée par les requêtes : 8 heures par défaut.
SESSION_TTL_SECONDS=28800
# lax convient à des sous-domaines HTTPS du même domaine ; none exige HTTPS.
SESSION_SAME_SITE=lax
# Un seul reverse proxy de confiance : Nginx sur le VPS.
TRUST_PROXY_HOPS=1

POSTGRES_DB=loup_garou
POSTGRES_USER=loup_garou
# Obligatoire : générer un secret d'au moins 16 caractères avant de lancer Compose.
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379

# Développement local uniquement (docker-compose.dev.yml).
DEV_DB_PORT=5439
DEV_REDIS_PORT=6389

# Fréquence de reprise des échéances des parties (250 à 60000 ms)
GAME_TICK_INTERVAL_MS=1000
