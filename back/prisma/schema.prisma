generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  username     String   @db.VarChar(24)
  usernameKey  String   @unique @db.VarChar(24)
  email        String   @unique @db.VarChar(254)
  passwordHash String
  createdAt    DateTime @default(now())
  ownedLobbies Lobby[] @relation("LobbyOwner")
  lobbyMemberships LobbyMembership[]
  gameParticipations GameParticipant[]
}

enum LobbyVisibility {
  PUBLIC
  PRIVATE
}

enum LobbyStatus {
  WAITING
  IN_GAME
  FINISHED
  CLOSED
}

model Lobby {
  id String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(80)
  visibility LobbyVisibility
  status LobbyStatus @default(WAITING)
  capacity Int
  discussionDurationSeconds Int @default(180)
  voteDurationSeconds Int @default(60)
  nightDurationSeconds Int @default(60)
  invitationHash String? @db.Char(64)
  ownerId String @db.Uuid
  owner User @relation("LobbyOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  memberships LobbyMembership[]
  game Game?

  @@index([visibility, status, createdAt, id])
}

model LobbyMembership {
  id String @id @default(uuid()) @db.Uuid
  lobbyId String @db.Uuid
  userId String @db.Uuid
  lobby Lobby @relation(fields: [lobbyId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  joinedAt DateTime @default(now())
  leftAt DateTime?

  // Active uniqueness is a partial PostgreSQL index in the versioned migration.
  @@index([lobbyId, userId, leftAt])
}

enum GameTeam {
  VILLAGE
  WEREWOLVES
}
enum GameStatus {
  IN_PROGRESS
  FINISHED
}
enum ParticipantStatus {
  ALIVE
  DEAD
}
enum PhaseType {
  NIGHT
  DAY_DISCUSSION
  DAY_VOTE
}
model Role {
  code String @id @db.VarChar(32)
  name String @db.VarChar(80)
  team GameTeam
  participants GameParticipant[]
  inspections NightAction[] @relation("InspectedRole")
}
model Game {
  id String @id @default(uuid()) @db.Uuid
  lobbyId String @unique @db.Uuid
  lobby Lobby @relation(fields: [lobbyId], references: [id], onDelete: Restrict)
  status GameStatus @default(IN_PROGRESS)
  startedAt DateTime @default(now())
  finishedAt DateTime?
  winner GameTeam?
  discussionDurationSeconds Int
  voteDurationSeconds Int
  nightDurationSeconds Int
  participants GameParticipant[]
  phases GamePhase[]
}
model GameParticipant {
  id String @id @default(uuid()) @db.Uuid
  gameId String @db.Uuid
  game Game @relation(fields: [gameId], references: [id], onDelete: Restrict)
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  usernameSnapshot String @db.VarChar(24)
  roleCode String @db.VarChar(32)
  role Role @relation(fields: [roleCode], references: [code], onDelete: Restrict)
  status ParticipantStatus @default(ALIVE)
  eliminatedAt DateTime?

  nightActions NightAction[] @relation("NightActor")
  nightTargets NightAction[] @relation("NightTarget")
  votes VillageVote[] @relation("VoteActor")
  votedBy VillageVote[] @relation("VoteTarget")
  eliminatedIn GamePhase[] @relation("PhaseVictim")

  @@unique([id, gameId])
  @@unique([gameId, userId])
}
model GamePhase {
  id String @id @default(uuid()) @db.Uuid
  gameId String @db.Uuid
  game Game @relation(fields: [gameId], references: [id], onDelete: Restrict)
  type PhaseType
  cycle Int
  startedAt DateTime
  deadline DateTime
  resolvedAt DateTime?
  eliminatedParticipantId String? @db.Uuid
  eliminatedParticipant GameParticipant? @relation("PhaseVictim", fields: [eliminatedParticipantId, gameId], references: [id, gameId], onDelete: Restrict)
  nightActions NightAction[]
  votes VillageVote[]

  @@unique([id, gameId])
  @@unique([gameId, cycle, type])
}

enum NightActionKind {
  WOLF_ATTACK
  SEER_INSPECT
}
model NightAction {
  id String @id @default(uuid()) @db.Uuid
  gameId String @db.Uuid
  phaseId String @db.Uuid
  phase GamePhase @relation(fields: [phaseId, gameId], references: [id, gameId], onDelete: Restrict)
  actorId String @db.Uuid
  actor GameParticipant @relation("NightActor", fields: [actorId, gameId], references: [id, gameId], onDelete: Restrict)
  targetId String? @db.Uuid
  target GameParticipant? @relation("NightTarget", fields: [targetId, gameId], references: [id, gameId], onDelete: Restrict)
  kind NightActionKind
  inspectedRoleCode String? @db.VarChar(32)
  inspectedRole Role? @relation("InspectedRole", fields: [inspectedRoleCode], references: [code], onDelete: Restrict)
  createdAt DateTime

  @@unique([phaseId, actorId])
}
model VillageVote {
  id String @id @default(uuid()) @db.Uuid
  gameId String @db.Uuid
  phaseId String @db.Uuid
  phase GamePhase @relation(fields: [phaseId, gameId], references: [id, gameId], onDelete: Restrict)
  actorId String @db.Uuid
  actor GameParticipant @relation("VoteActor", fields: [actorId, gameId], references: [id, gameId], onDelete: Restrict)
  targetId String? @db.Uuid
  target GameParticipant? @relation("VoteTarget", fields: [targetId, gameId], references: [id, gameId], onDelete: Restrict)
  createdAt DateTime

  @@unique([phaseId, actorId])
}
